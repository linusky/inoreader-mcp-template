# InoReader Developer App credentials (create at https://www.inoreader.com/preferences/ -> Developer)
INOREADER_CLIENT_ID=your-inoreader-app-id
INOREADER_CLIENT_SECRET=your-inoreader-app-key

# Optional: Must match the Redirect URI configured in your InoReader Developer App
# INOREADER_REDIRECT_URI=http://127.0.0.1:8787/callback

# Optional: OAuth2 scopes ("read" for read-only, "read write" for full management)
# INOREADER_SCOPE="read write"
